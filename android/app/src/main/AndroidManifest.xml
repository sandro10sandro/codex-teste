<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Captura de áudio pelo microfone (único caminho universal sem privilégio de sistema). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Detecção de chamadas celulares e identificação de número/contato. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Serviço em primeiro plano (obrigatório para manter captura de microfone). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Importação de gravações nativas do fabricante (MediaStore). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Declarada de propósito, para a sonda documentar tecnicamente o limite:
        CAPTURE_AUDIO_OUTPUT é signature|privileged. Em app instalado pelo usuário o
        checkSelfPermission() retorna DENIED, e é isso que o relatório registra.
        Se algum aparelho de laboratório a conceder (build userdebug/OEM), a sonda detecta.
    -->
    <uses-permission
        android:name="android.permission.CAPTURE_AUDIO_OUTPUT"
        tools:ignore="ProtectedPermissions" />

    <!-- Visibilidade de pacotes para o diagnóstico de discadores/gravadores do fabricante. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.google.android.dialer" />
        <package android:name="com.android.dialer" />
        <package android:name="com.samsung.android.dialer" />
        <package android:name="com.samsung.android.incallui" />
        <package android:name="com.motorola.dialer" />
        <package android:name="com.motorola.callredirection" />
        <package android:name="com.android.incallui" />
        <package android:name="com.miui.voiceassist" />
        <package android:name="com.miui.soundrecorder" />
        <package android:name="com.android.soundrecorder" />
        <package android:name="com.coloros.soundrecorder" />
        <package android:name="com.oplus.soundrecorder" />
        <package android:name="com.huawei.soundrecorder" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RecordingsActivity"
            android:exported="false" />

        <service
            android:name=".record.CallRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Acesso a notificações: nome/aplicativo e início/fim das chamadas por app (WhatsApp). -->
        <service
            android:name=".telephony.VoipNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Serviço de acessibilidade mínimo (sem eventos, sem leitura de janela). Necessário para gravar durante
            chamada: pela doc do Android, um app comum recebe silêncio do microfone em chamada, salvo serviço de
            acessibilidade.
        -->
        <service
            android:name=".record.KeepAliveAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
